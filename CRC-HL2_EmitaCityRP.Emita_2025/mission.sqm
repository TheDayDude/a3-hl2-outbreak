					class Attributes
					{
						init="this addAction [""Buy Breen's Private Reserve (1 Tokens)"", {      " \n "    private _tokens = {_x == 'VRP_HL_Token_Item'} count items player;      " \n "    if (_tokens >= 1) then {      " \n "        for ""_i"" from 1 to 1 do { player removeItem ""VRP_HL_Token_Item""; };     " \n "        player addItem ""VRP_HL2_BreenWater"";      " \n "        hint ""Mmmmm, Union Approved Water!"";      " \n "    } else {      " \n "        hint ""You need 1 tokens to buy Breen Water."";      " \n "    };      " \n "}];    " \n "    " \n "this addAction [""Buy Breen's Private Reserve - Red (2 Token)"", {      " \n "    private _tokens = {_x == 'VRP_HL_Token_Item'} count items player;      " \n "    if (_tokens >= 2) then {      " \n "        for ""_i"" from 1 to 2 do { player removeItem ""VRP_HL_Token_Item""; };     " \n "        player addItem ""VRP_HL2_RedWater"";      " \n "        hint ""Slightly fizzy, and a hint of flavor - though it reminds you of medicine."";      " \n "    } else {      " \n "        hint ""You need 2 tokens to buy Red Water."";      " \n "    };      " \n "}];    " \n " " \n "this addAction [""Buy Breen's Private Reserve - Gold (3 Token)"", {      " \n "    private _tokens = {_x == 'VRP_HL_Token_Item'} count items player;      " \n "    if (_tokens >= 3) then {      " \n "        for ""_i"" from 1 to 3 do { player removeItem ""VRP_HL_Token_Item""; };     " \n "        player addItem ""VRP_HL2_YellowWater"";      " \n "        hint ""Smooth, flavorful. What kind of flavor? You're not quite sure."";      " \n "    } else {      " \n "        hint ""You need 3 tokens to buy Gold Water."";      " \n "    };      " \n "}]; ";
					};
					id=28989;
					type="Land_Cyt_VendingMachine2";
					atlOffset=-0.04172039;
					class CustomAttributes
					{
						class Attribute0
						{
							property="ObjectCollision";
							expression="[_this, 	(			[false,true] select (if 		(_value in [true,false]) 	then 	{parseNumber _value} else {_value # 0}		 ) ) 	] remoteExecCall ['setPhysicsCollisionFlag', 0, _this];";
							class Value
