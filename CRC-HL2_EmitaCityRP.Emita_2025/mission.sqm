										value="if (side _caller != civilian) exitWith {  " \n "       hint ""Only civilians would be foolish enough to try this..."";  " \n "    };  " \n "  " \n "    private _success = (random 100) < 10;  " \n "  " \n "    if (_success) then {  " \n "        _caller addItem ""WBK_Health_ArmourPlate"";  " \n "        hint ""You successfully smuggled an Alloy Plate. Keep it hidden!"";  " \n "    } else {  " \n "        hint ""Security systems triggered! You have been flagged."";  " \n "        [_caller] joinSilent createGroup east;  " \n "    };";
									};
								};
