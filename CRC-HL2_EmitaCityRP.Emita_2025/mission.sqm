			{
				onActivation="{ " \n "    if (isPlayer _x) then { " \n "  private _triggerArea = thisTrigger; " \n "        [_x, _triggerArea] spawn { " \n "            params [""_unit"", ""_zone""]; " \n " " \n "            while {alive _unit && _unit inArea _zone} do { " \n "                _unit setDamage ((damage _unit) + 0.05); " \n "                cutText [""<t color='#ff0000' size='3'>You feel a swarm of leeches eating you alive..."", ""PLAIN"", -1, true, true]; " \n "                _unit say3D ""WBL_HL_headcrab_attach""; " \n "                sleep 1.5; " \n "            }; " \n "        }; " \n "    }; " \n "} forEach thisList; " \n "";
				sizeA=1000;
				sizeB=500;
				repeatable=1;
				activationBy="ANYPLAYER";
				isRectangle=1;
				triggerInterval=1;
				effectVoice="WBK_HL_headcrab_attach";
			};
