class HL2_CommandMenu
{
        idd = 9000;
        movingEnable = 0;
        enableSimulation = 1;
        onLoad = "uiNamespace setVariable ['HL2_CommandMenu', _this select 0];";
        onUnload = "uiNamespace setVariable ['HL2_CommandMenu', displayNull];";

        class controlsBackground
        {
                class Background: RscText
                {
                        colorBackground[] = {0, 0, 0, 0.8};
                        x = 0.35;
                        y = 0.25;
                        w = 0.3;
                        h = 0.34;
                };
                class Frame: RscFrame
                {
                        x = 0.35;
                        y = 0.25;
                        w = 0.3;
                        h = 0.34;
                };
        };

        class controls
        {
                class Title: RscText
                {
                        idc = 9001;
                        text = "Field Support";
                        colorBackground[] = {0.1, 0.4, 0.6, 0.9};
                        style = 2;
                        x = 0.35;
                        y = 0.25;
                        w = 0.3;
                        h = 0.04;
                        SizeEx = 0.045;
                };

                class RequestMission: RscButton
                {
                        idc = 9100;
