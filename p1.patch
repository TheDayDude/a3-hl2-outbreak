+if (isNil "HL2_fnc_serverShowCivilRegistry") then {
+    HL2_fnc_serverShowCivilRegistry = {
+        params ["_requester"];
+        if (!isServer) exitWith {};
+        if (isNull _requester || {!isPlayer _requester}) exitWith {};
+
+        private _lines = [];
+        {
+            if (!isPlayer _x) then { continue };
