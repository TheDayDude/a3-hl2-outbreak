+    _target setVariable ["backUpGroup", _grp];
+    [_grp,_target] spawn MRC_fnc_trackBackUp;
+};
+
+MRC_fnc_scheduleBackUp = {
+    params ["_target"];
+    private _lvl = _target getVariable ["wantedLevel",0];
+    if (_lvl == 0) exitWith {};
+    if (!(_target inArea City18)) exitWith {};
